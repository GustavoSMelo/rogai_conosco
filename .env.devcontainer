# Devcontainer environment overrides (MariaDB)
# Copy relevant lines into .env when using the devcontainer:
#   cp .env.devcontainer >> .env
# Then run: php artisan config:clear

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=rogaiconosco
DB_USERNAME=rogaiconosco
DB_PASSWORD=rogaiconosco
